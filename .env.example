# --- Docker stack (docker compose reads this file) ---
POSTGRES_USER=chatmixer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat-mixer
POSTGRES_PORT=5434

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5051

API_PORT=8090

# --- Garage (S3 bucket for image attachments) ---
# generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
GARAGE_PORT=3900

# --- API ---
# S3-compatible bucket for attachments. Leave S3_ENDPOINT empty to disable uploads.
# The dockerized API uses http://garage:3900; `go run .` uses the host port.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=chat-mixer
# access key: "GK" + 32 hex chars (openssl rand -hex 16), secret: openssl rand -hex 32
S3_ACCESS_KEY=GKchange-me
S3_SECRET_KEY=change-me

# GIPHY API key for the GIF picker (https://developers.giphy.com). Leave empty to disable it.
GIPHY_API_KEY=

# Used by `go run .` on the host. The dockerized API builds its own DB_URL
# from the POSTGRES_* values above.
DB_URL=postgres://chatmixer:change-me@localhost:5434/chat-mixer?sslmode=disable

# JWT signing secret — generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Server port for `go run .` (defaults to 8080)
PORT=8090
