# --- Docker stack (docker compose reads this file) ---
POSTGRES_USER=chatmixer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat-mixer
POSTGRES_PORT=5434

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5051

API_PORT=8090

# --- API ---
# Used by `go run .` on the host. The dockerized API builds its own DB_URL
# from the POSTGRES_* values above.
DB_URL=postgres://chatmixer:change-me@localhost:5434/chat-mixer?sslmode=disable

# JWT signing secret — generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Server port for `go run .` (defaults to 8080)
PORT=8090
